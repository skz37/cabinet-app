# Copy to .env.local (git-ignored) and adjust. Restart `npm run dev` after a change.

# Gateway of the real backend
EXPO_PUBLIC_API_URL=http://localhost:9222

# true = serve mobile-mock-api/ JSON files, false = call the real API
EXPO_PUBLIC_USE_MOCKS=true

# normal | empty (new patient) | error (every data call fails) | expired (silent refresh fails)
EXPO_PUBLIC_MOCK_SCENARIO=normal
